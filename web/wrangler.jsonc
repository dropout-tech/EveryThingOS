{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dropout-os",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // os.dropout.tw is created on deploy. Company sites use the wildcard route, which needs a proxied
  // DNS record "*.os" (AAAA 100::) in the dropout.tw zone; the glue maps each host to its company.
  "routes": [
    { "pattern": "os.dropout.tw", "custom_domain": true },
    { "pattern": "*.os.dropout.tw/*", "zone_name": "dropout.tw" }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
