{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dropout-os",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // The custom domain is created on deploy. Wildcard routes require host-to-company mapping first.
  "routes": [
    { "pattern": "os.dropout.tw", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  // 測試帳本。database_id 是占位，正式庫還沒建。這一刀只用 wrangler --local。
  // 不要部署、不要建立 os.dropout.tw、不要把單據放進 R2。R2 只放檔案。
  "d1_databases": [
    {
      "binding": "ACCOUNTS",
      "database_name": "everythingos-accounts",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "d1/migrations"
    },
    {
      "binding": "DB",
      "database_name": "dropout-ledger-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
