{
 "doctype": "Stock Reconciliation",
 "note": "表頭依實際匯出檔確認；不同版本若表頭不同，把新表頭加進 from 陣列即可，不用改程式。 匯入時加 --submit-after-import。",
 "parent": {
  "company": {
   "default": "{company}"
  },
  "purpose": {
   "default": "Opening Stock"
  },
  "posting_date": {
   "default": "{posting_date}"
  },
  "set_posting_time": {
   "default": "1"
  }
 },
 "child_table": "items",
 "fields": {
  "item_code": {
   "from": [
    "品項代碼",
    "品項編碼"
   ],
   "required": true
  },
  "warehouse": {
   "from": [
    "倉庫代碼",
    "倉庫名稱",
    "倉庫"
   ],
   "default": "{warehouse}"
  },
  "qty": {
   "from": [
    "庫存數量",
    "數量"
   ],
   "transform": "number",
   "required": true
  },
  "valuation_rate": {
   "from": [
    "入庫單價",
    "單價"
   ],
   "transform": "number"
  }
 }
}
