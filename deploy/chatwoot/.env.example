# Chatwoot settings. Copy to .env on the host; never commit the filled file.
SECRET_KEY_BASE=
FRONTEND_URL=https://chat.dropout.tw
DEFAULT_LOCALE=zh_TW
ENABLE_ACCOUNT_SIGNUP=false
FORCE_SSL=false

POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=

# Attachments on Cloudflare R2 (S3 compatible)
ACTIVE_STORAGE_SERVICE=s3_compatible
STORAGE_BUCKET_NAME=dropout-chatwoot
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_FORCE_PATH_STYLE=true

# Outgoing mail for agent notifications
MAILER_SENDER_EMAIL=DropOut 對話 <chat@dropout.tw>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
