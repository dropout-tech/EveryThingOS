{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dropout-glue",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "dropout-glue", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "dropout-jobs" }],
    "consumers": [
      { "queue": "dropout-jobs", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "dropout-jobs-dlq" },
      { "queue": "dropout-jobs-dlq", "max_batch_size": 10 }
    ]
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "ai": { "binding": "AI" },
  "send_email": [{ "name": "EMAIL" }],
  // Public API /v1: 120 requests per minute per API key (and per IP for failed logins).
  "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "vars": {
    "SUMMARY_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  }
  // Secrets (wrangler secret put): TENANT_KEY (base64, 32 bytes), ADMIN_TOKEN, SHELL_TOKEN (the shell's narrower key), optional TURNSTILE_SECRET, AI_GATEWAY, RESEND_API_KEY (renewal reminders to customers). Vars: PLATFORM_MAIL_FROM, PLATFORM_NOTIFY (verified ops address for copies).
}
