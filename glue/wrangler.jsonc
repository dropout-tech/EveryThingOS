{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dropout-glue",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    { "binding": "DB", "database_name": "dropout-glue", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // One bucket. ERPNext writes <site>/ via S3 keys. This binding writes meetings/ and the D1 export writes d1/.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "dropout-backups" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "dropout-jobs" }],
    "consumers": [
      { "queue": "dropout-jobs", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "dropout-jobs-dlq" },
      { "queue": "dropout-jobs-dlq", "max_batch_size": 10 }
    ]
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "ai": { "binding": "AI" },
  "send_email": [{ "name": "EMAIL" }],
  // Public API /v1: 120 requests per minute per API key (and per IP for failed logins).
  "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "vars": {
    "SUMMARY_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  }
  // Secrets (wrangler secret put): TENANT_KEY (base64, 32 bytes), ADMIN_TOKEN, SHELL_TOKEN (the shell's narrower key), optional TURNSTILE_SECRET, AI_GATEWAY, RESEND_API_KEY (renewal reminders to customers), ALERT_WEBHOOK_URL and ALERT_WEBHOOK_TOKEN (ops alerts from uptime checks). Vars: PLATFORM_MAIL_FROM, PLATFORM_NOTIFY (verified ops address for copies and alerts).
  // Renewal billing (docs/BILLING.md): secrets BILLING_ECPAY_MERCHANT_ID, BILLING_ECPAY_HASH_KEY, BILLING_ECPAY_HASH_IV, optional BILLING_EINVOICE_MERCHANT_ID/HASH_KEY/HASH_IV. Vars: GLUE_PUBLIC_URL, BILLING_ECPAY_ENV and BILLING_EINVOICE_ENV ("production" for live; anything else is staging).
}
